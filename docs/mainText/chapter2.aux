\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Summary output of each parameter from our four predictors, using ring width (log(mm)) as the reponse variable (See equation \ref {eq:mainMdl}). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' section in Methods for more details.}}{38}{table.caption.33}\protected@file@percent }
\newlabel{tab:tab_all}{{S3}{38}{Summary output of each parameter from our four predictors, using ring width (log(mm)) as the reponse variable (See equation \ref {eq:mainMdl}). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' section in Methods for more details}{table.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Summary output of each parameter from the previous year model (Equation \ref {eq:prvsYrMdl}) using ring width (log(mm)) as the reponse variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets). see `Data analyses' section in Methods for more details}}{39}{table.caption.34}\protected@file@percent }
\newlabel{tab:tab_PrvsYr}{{S4}{39}{Summary output of each parameter from the previous year model (Equation \ref {eq:prvsYrMdl}) using ring width (log(mm)) as the reponse variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets). see `Data analyses' section in Methods for more details}{table.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Summary output of each parameter from the model on the effect of SOS (days) on EOS (days; Equation \ref {eq:SOSonEOSMdl}). We report estimates as mean and 90\% uncertainty intervals (in square brackets). see `Data analyses' section in Methods for more details}}{40}{table.caption.35}\protected@file@percent }

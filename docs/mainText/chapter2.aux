\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Estimates of ring width change (log(mm)) as a function of four different phenological predictors: growing degree days of the growing season (mean daily temperature above 5\ensuremath  {^\circ }C); growing season length; start of season; end of season across 11 species: (Red maple (\textit  {Acer rubrum}), Sugar maple (\textit  {Acer saccharum}), Yellow buckeye (\textit  {Aesculus flava}), Yellow birch (\textit  {Betula alleghaniensis}), River birch (\textit  {Betula nigra}), Pignut hickory (\textit  {Carya glabra}), Shagbark hickory (\textit  {Carya ovata}), Eastern cottonwood (\textit  {Populus deltoides}), White oak (\textit  {Quercus alba}), Northern red oak (\textit  {Quercus rubra}) and American basswood (\textit  {Tilia americana})); species colors are the same across the panels). Panels (a) to (d) represent the model slope estimates for each species, for each predictor, which we represent through $\Delta $ RW/scaled predictor (see `Data analyses' section in Methods for more details on predictor scaling). The dots represent the mean of each species and the lines, the 50\% and 90\% uncertainty intervals (UI; see Table \ref {tab:ts_slope_table} for parameter estimates). Panels (e) to (h) represent the simulated response curves of ring width as a function of each predictor, with the lines depicting the mean response at each simulated predictor value, and the shaded area, the interquantile ranges (50\% UI). These models do not include a slope on the previous year GDD (see Figure \ref {fig:tsPrvsYr} for these estimates).}}{31}{figure.caption.28}\protected@file@percent }
\newlabel{fig:tsmuplotbspp}{{S2}{31}{Estimates of ring width change (log(mm)) as a function of four different phenological predictors: growing degree days of the growing season (mean daily temperature above 5\degree C); growing season length; start of season; end of season across 11 species: (Red maple (\textit {Acer rubrum}), Sugar maple (\textit {Acer saccharum}), Yellow buckeye (\textit {Aesculus flava}), Yellow birch (\textit {Betula alleghaniensis}), River birch (\textit {Betula nigra}), Pignut hickory (\textit {Carya glabra}), Shagbark hickory (\textit {Carya ovata}), Eastern cottonwood (\textit {Populus deltoides}), White oak (\textit {Quercus alba}), Northern red oak (\textit {Quercus rubra}) and American basswood (\textit {Tilia americana})); species colors are the same across the panels). Panels (a) to (d) represent the model slope estimates for each species, for each predictor, which we represent through \RW scaled predictor (see `Data analyses' section in Methods for more details on predictor scaling). The dots represent the mean of each species and the lines, the 50\% and 90\% uncertainty intervals (UI; see Table \ref {tab:ts_slope_table} for parameter estimates). Panels (e) to (h) represent the simulated response curves of ring width as a function of each predictor, with the lines depicting the mean response at each simulated predictor value, and the shaded area, the interquantile ranges (50\% UI). These models do not include a slope on the previous year GDD (see Figure \ref {fig:tsPrvsYr} for these estimates)}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Model slope estimates representing ring width change (log(mm)) as a function of the current year growing degree days (GDD; a) and the previous year GDD (b). GDD represent the accumulated growing degree days (mean daily temperature above 5\ensuremath  {^\circ }C)) between leafout and leaf colouring and the models estimates shows ring width change (log(mm)) per scaled GDD (see `Data analyses' section in Methods). The dots represent the mean of each species and the lines, the 50\% and 90\% uncertainty intervals (UI).}}{32}{figure.caption.29}\protected@file@percent }
\newlabel{fig:tsPrvsYr}{{S3}{32}{Model slope estimates representing ring width change (log(mm)) as a function of the current year growing degree days (GDD; a) and the previous year GDD (b). GDD represent the accumulated growing degree days (mean daily temperature above 5\degree C)) between leafout and leaf colouring and the models estimates shows ring width change (log(mm)) per scaled GDD (see `Data analyses' section in Methods). The dots represent the mean of each species and the lines, the 50\% and 90\% uncertainty intervals (UI)}{figure.caption.29}{}}

\newlabel{tab:ts_slope_table}{{S2}{36}{Species level slope parameters which represent ring width change (log(mm)), per scaled predictor (see `Data analyses' section in Methods for more details on predictor scaling). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). Table \ref {tab:tab_all} reports all the models parameters}{table.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Ring width (log(mm)) deviations from the grand mean for each year using the GDD model (Table \ref {tab:tab_all}). The dots are the mean of the posterior distribution and the thick and thin lines, the 50 and 90\% UI.}}{36}{figure.caption.36}\protected@file@percent }
\newlabel{fig:tsmuplotayear}{{S2}{36}{Ring width (log(mm)) deviations from the grand mean for each year using the GDD model (Table \ref {tab:tab_all}). The dots are the mean of the posterior distribution and the thick and thin lines, the 50 and 90\% UI}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Boxplot representing the empirical data of our ring widths (mm) across years, facetted by species. The dots represent the raw data, the line the mean and the box the interquantile range (IQR).}}{37}{figure.caption.37}\protected@file@percent }

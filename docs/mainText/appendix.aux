\@writefile{lot}{\contentsline {table}{\numberline {A.1}{\ignorespaces Provenance coordinates and count per species and provenances out of a total of 81 individual trees sampled from the United States of America (in Massachusetts (MA) and New Hampshire(NH)) and Canada (in Quebec (Qc)).}}{42}{table.caption.19}\protected@file@percent }
\newlabel{tab:provs}{{A.1}{42}{Provenance coordinates and count per species and provenances out of a total of 81 individual trees sampled from the United States of America (in Massachusetts (MA) and New Hampshire(NH)) and Canada (in Quebec (Qc))}{table.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.2}{\ignorespaces Species-level slope parameters which represent ring width change (log(mm)), per adjusted predictor (see `Data analyses' in Methods for more details). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different phenological predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season).}}{42}{table.caption.22}\protected@file@percent }
\newlabel{tab:wc_slope_table}{{A.2}{42}{Species-level slope parameters which represent ring width change (log(mm)), per adjusted predictor (see `Data analyses' in Methods for more details). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different phenological predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season)}{table.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.1}{\ignorespaces Leaf phenology monitoring frequency across years. We monitored leaf phenology once or twice per week for three years, though the frequency varied within and across years. Each histogram bin represents the number of observations that were made during a period of 14 days and the lines represent the earliest, the average and last recorded budburst observations. This demonstrates that across the different frequencies of observation, distances between early spring phenophases were similar across years.}}{43}{figure.caption.20}\protected@file@percent }
\newlabel{fig:phenoTimeSeries}{{A.1}{43}{Leaf phenology monitoring frequency across years. We monitored leaf phenology once or twice per week for three years, though the frequency varied within and across years. Each histogram bin represents the number of observations that were made during a period of 14 days and the lines represent the earliest, the average and last recorded budburst observations. This demonstrates that across the different frequencies of observation, distances between early spring phenophases were similar across years}{figure.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.3}{\ignorespaces The effect of provenance on ring widths (log(mm)). We report these intercept estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season).}}{43}{table.caption.23}\protected@file@percent }
\newlabel{tab:wc_asite_table}{{A.3}{43}{The effect of provenance on ring widths (log(mm)). We report these intercept estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season)}{table.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.2}{\ignorespaces We show the potential allometry patterns across all years we had ring width for. For this, we randomly sampled 20 trees from our dataset and represented their ring width (mm) for each year.}}{44}{figure.caption.21}\protected@file@percent }
\newlabel{fig:allom}{{A.2}{44}{We show the potential allometry patterns across all years we had ring width for. For this, we randomly sampled 20 trees from our dataset and represented their ring width (mm) for each year}{figure.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.4}{\ignorespaces Summary output of each parameter from our four predictors, using ring width (log(mm)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' in Methods section for more details.}}{45}{table.caption.24}\protected@file@percent }
\newlabel{tab:tab_all}{{A.4}{45}{Summary output of each parameter from our four predictors, using ring width (log(mm)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' in Methods section for more details}{table.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.5}{\ignorespaces Summary output of each parameter from our four predictors, using basal area increment (log($mm^2$)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See 'Data analyses' section for more details.}}{46}{table.caption.25}\protected@file@percent }
\newlabel{tab:BAItab}{{A.5}{46}{Summary output of each parameter from our four predictors, using basal area increment (log($mm^2$)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See 'Data analyses' section for more details}{table.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.6}{\ignorespaces Species-level slope parameters which represent ring width change (log(mm)), per scaled predictor (see `Data analyses' section in Methods for more details on predictor scaling). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). Table \ref {tab:tab_all} reports all the model's parameters.}}{46}{table.caption.34}\protected@file@percent }
\newlabel{tab:ts_slope_table}{{A.6}{46}{Species-level slope parameters which represent ring width change (log(mm)), per scaled predictor (see `Data analyses' section in Methods for more details on predictor scaling). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). Table \ref {tab:tab_all} reports all the model's parameters}{table.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.3}{\ignorespaces Full vs most restricted datasets for the model with start of season (a-d) and end of season (d-h) as the predictor. Each panel represent the different parameters used to fit the models. $\sigma $ (a, e), $\alpha _{species}$ (c, g) and $\alpha _{year}$ (d,h) represent the ring width (log(mm)) for species and year, respectively. $\beta _{species}$ (b, f) represents the change in ring width (log(mm))/adjusted predictor, for each species (see `Data analyses' section in Methods for more details).}}{47}{figure.caption.26}\protected@file@percent }
\newlabel{fig:wcSOSEOScomparison}{{A.3}{47}{Full vs most restricted datasets for the model with start of season (a-d) and end of season (d-h) as the predictor. Each panel represent the different parameters used to fit the models. $\sigma $ (a, e), $\alpha _{species}$ (c, g) and $\alpha _{year}$ (d,h) represent the ring width (log(mm)) for species and year, respectively. $\beta _{species}$ (b, f) represents the change in ring width (log(mm))/adjusted predictor, for each species (see `Data analyses' section in Methods for more details)}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.4}{\ignorespaces Ring width (log(mm)) trends in response to thermal season (growing degree days). The plots are the reconstructed species estimates posterior distribution with error. The lines represent the mean of the posterior distribution and the shaded area, the 50\% UI at each predictor value. The dots are the empirical data shaped by year.}}{48}{figure.caption.27}\protected@file@percent }
\newlabel{fig:wcxyGDD}{{A.4}{48}{Ring width (log(mm)) trends in response to thermal season (growing degree days). The plots are the reconstructed species estimates posterior distribution with error. The lines represent the mean of the posterior distribution and the shaded area, the 50\% UI at each predictor value. The dots are the empirical data shaped by year}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.5}{\ignorespaces Ring width trends (log(mm)) in response to calendar season (growing season length). The plots are the reconstructed species estimates posterior distribution with error. The lines represent the mean of the posterior distribution and the shaded area, the 50\% UI at each predictor value. The dots are the empirical data shaped by year.}}{49}{figure.caption.28}\protected@file@percent }
\newlabel{fig:wcxyGSL}{{A.5}{49}{Ring width trends (log(mm)) in response to calendar season (growing season length). The plots are the reconstructed species estimates posterior distribution with error. The lines represent the mean of the posterior distribution and the shaded area, the 50\% UI at each predictor value. The dots are the empirical data shaped by year}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.6}{\ignorespaces Ring width (log(mm)) deviations from the grand mean for grouping factor of the GDD model. The different tree id values represent the combined intercepts of tree id, provenance, species and averaged year intercepts. The larger dots and lines represent the species intercepts which are the species-level estimates averaged across all of their tree ids. The dots are the mean of the posterior distribution, and the thick and thin lines, the 50 and 90\% UI.}}{50}{figure.caption.29}\protected@file@percent }
\newlabel{fig:wcmuplotatreeid}{{A.6}{50}{Ring width (log(mm)) deviations from the grand mean for grouping factor of the GDD model. The different tree id values represent the combined intercepts of tree id, provenance, species and averaged year intercepts. The larger dots and lines represent the species intercepts which are the species-level estimates averaged across all of their tree ids. The dots are the mean of the posterior distribution, and the thick and thin lines, the 50 and 90\% UI}{figure.caption.29}{}}

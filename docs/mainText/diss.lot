\contentsline {table}{\numberline {A.1}{\ignorespaces Provenance coordinates and count per species and provenances out of a total of 81 individual trees sampled from the United States of America (in Massachusetts (MA) and New Hampshire(NH)) and Canada (in Quebec (Qc)).}}{42}{table.caption.19}%
\contentsline {table}{\numberline {A.2}{\ignorespaces Species level slope parameters which represent ring width change (log(mm)), per adjusted predictor (see `Data analyses' in Methods for more details). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different phenological predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season).}}{45}{table.caption.22}%
\contentsline {table}{\numberline {A.3}{\ignorespaces The effect of provenance on ring widths (log(mm)). We report these intercept estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season).}}{45}{table.caption.23}%
\contentsline {table}{\numberline {A.4}{\ignorespaces Summary output of each parameter from our four predictors, using ring width (log(mm)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' in Methods section for more details.}}{46}{table.caption.24}%
\contentsline {table}{\numberline {A.5}{\ignorespaces Summary output of each parameter from our four predictors, using basal area increment (log($mm^2$)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See data analyses section for more details.}}{47}{table.caption.25}%
\contentsline {table}{\numberline {A.6}{\ignorespaces Species level slope parameters which represent ring width change (log(mm)), per scaled predictor (see `Data analyses' section in Methods for more details on predictor scaling). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). Table \ref {tab:tab_all} reports all the models parameters.}}{47}{table.caption.34}%
\contentsline {table}{\numberline {A.7}{\ignorespaces Summary output of each parameter from our four predictors, using ring width (log(mm)) as the response variable (See equation \ref {eq:mainMdl}). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' section in Methods for more details.}}{56}{table.caption.35}%
\contentsline {table}{\numberline {A.8}{\ignorespaces Summary output of each parameter from the previous year model (Equation \ref {eq:prvsYrMdl}) using ring width (log(mm)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets). see `Data analyses' section in Methods for more details}}{57}{table.caption.36}%
\contentsline {table}{\numberline {A.9}{\ignorespaces Summary output of each parameter from the model on the effect of SOS (days) on EOS (days; Equation \ref {eq:SOSonEOSMdl}). We report estimates as mean and 90\% uncertainty intervals (in square brackets). see `Data analyses' section in Methods for more details}}{58}{table.caption.37}%

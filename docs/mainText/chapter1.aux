\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Provenance coordinates and count per species and provenances out of a total of 81 individual trees sampled from the United States of America (in Massachusetts (MA) and New Hampshire(NH)) and Canada (in Quebec (Qc)).}}{15}{table.caption.13}\protected@file@percent }
\newlabel{tab:provs}{{S1}{15}{Provenance coordinates and count per species and provenances out of a total of 81 individual trees sampled from the United States of America (in Massachusetts (MA) and New Hampshire(NH)) and Canada (in Quebec (Qc))}{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Leaf phenology monitoring frequency across years. We monitored leaf phenology once or twice per week for three years, though the frequency varied within and across years. Each histogram bin represents the number of observations that were made during a period of 14 days and the lines represent the earliest, the average and last recorded budburst observations. This demonstrates that across the different frequencies of observation, distances between early spring phenophases were similar across years.}}{16}{figure.caption.14}\protected@file@percent }
\newlabel{fig:phenoTimeSeries}{{S1}{16}{Leaf phenology monitoring frequency across years. We monitored leaf phenology once or twice per week for three years, though the frequency varied within and across years. Each histogram bin represents the number of observations that were made during a period of 14 days and the lines represent the earliest, the average and last recorded budburst observations. This demonstrates that across the different frequencies of observation, distances between early spring phenophases were similar across years}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces We show the potential allometry patterns across all years we had ring width for. For this, we randomly sampled 20 trees from our dataset and represent their ring width (mm) for each year.}}{17}{figure.caption.15}\protected@file@percent }
\newlabel{fig:allom}{{S2}{17}{We show the potential allometry patterns across all years we had ring width for. For this, we randomly sampled 20 trees from our dataset and represent their ring width (mm) for each year}{figure.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Species level slope parameters which represent ring width change (log(mm)), per adjusted predictor (see `Data analyses' in Methods for more details). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different phenological predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season).}}{18}{table.caption.16}\protected@file@percent }
\newlabel{tab:wc_slope_table}{{S2}{18}{Species level slope parameters which represent ring width change (log(mm)), per adjusted predictor (see `Data analyses' in Methods for more details). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different phenological predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season)}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces The effect of provenance on ring widths (log(mm)). We report these intercept estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season).}}{18}{table.caption.17}\protected@file@percent }
\newlabel{tab:wc_asite_table}{{S3}{18}{The effect of provenance on ring widths (log(mm)). We report these intercept estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season)}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Summary output of each parameter from our four predictors, using ring width (log(mm)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' in Methods section for more details.}}{19}{table.caption.18}\protected@file@percent }
\newlabel{tab:tab_all}{{S4}{19}{Summary output of each parameter from our four predictors, using ring width (log(mm)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' in Methods section for more details}{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Summary output of each parameter from our four predictors, using basal area increment (log($mm^2$)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See data analyses section for more details.}}{20}{table.caption.19}\protected@file@percent }
\newlabel{tab:BAItab}{{S5}{20}{Summary output of each parameter from our four predictors, using basal area increment (log($mm^2$)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See data analyses section for more details}{table.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Full vs most restricted datasets for the model with start of season (a-d) and end of season (d-h) as the predictor. Each panel represent the different parameters used to fit the models. $\sigma $ (a, e), $\alpha _{species}$ (c, g) and $\alpha _{year}$ (d,h) represent the ring width (log(mm)) for species and year, respectively. $\beta _{species}$ (b, f) represent the change in ring width (log(mm))/adjusted predictor, for each species (see 'Data analyses' section in Methods for more details).}}{21}{figure.caption.20}\protected@file@percent }
\newlabel{fig:wcSOSEOScomparison}{{S3}{21}{Full vs most restricted datasets for the model with start of season (a-d) and end of season (d-h) as the predictor. Each panel represent the different parameters used to fit the models. $\sigma $ (a, e), $\alpha _{species}$ (c, g) and $\alpha _{year}$ (d,h) represent the ring width (log(mm)) for species and year, respectively. $\beta _{species}$ (b, f) represent the change in ring width (log(mm))/adjusted predictor, for each species (see 'Data analyses' section in Methods for more details)}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Ring width (log(mm)) trends in response to thermal season (growing degree days). The plots are the reconstructed species estimates posterior distribution with error. The lines represent the mean of the posterior distribution and the shaded area, the 50\% UI at each predictor value. The dots are the empirical data shaped by year.}}{22}{figure.caption.21}\protected@file@percent }

\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Provenance coordinates and count per species and provenances out of a total of 81 individual trees sampled from the United States of America (in Massachusetts (MA) and New Hampshire(NH)) and Canada (in Quebec (Qc)).}}{58}{table.caption.55}\protected@file@percent }
\newlabel{tab:provs}{{S1}{58}{Provenance coordinates and count per species and provenances out of a total of 81 individual trees sampled from the United States of America (in Massachusetts (MA) and New Hampshire(NH)) and Canada (in Quebec (Qc))}{table.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Overview of the age class, species, provenance of the trees used in each study along with the type of study each chapter consists of. The colored lines represent the period of the growth data and the shaded areas are the phenological data. Both are colour-coded by project. Each phylogram illustrates the species used in each project. The map illustrates the four different provenances used in Chapter 1, and the star represents the study location of both chapters}}{59}{figure.caption.54}\protected@file@percent }
\newlabel{fig:chaptdesign}{{S1}{59}{Overview of the age class, species, provenance of the trees used in each study along with the type of study each chapter consists of. The colored lines represent the period of the growth data and the shaded areas are the phenological data. Both are colour-coded by project. Each phylogram illustrates the species used in each project. The map illustrates the four different provenances used in Chapter 1, and the star represents the study location of both chapters}{figure.caption.54}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Leaf phenology monitoring frequency across years. We monitored leaf phenology once or twice per week for three years, though the frequency varied within and across years. Each histogram bin represents the number of observations that were made during a period of 14 days and the lines represent the earliest, the average and last recorded budburst observations. This demonstrates that across the different frequencies of observation, distances between early spring phenophases were similar across years.}}{60}{figure.caption.56}\protected@file@percent }
\newlabel{fig:phenoTimeSeries}{{S2}{60}{Leaf phenology monitoring frequency across years. We monitored leaf phenology once or twice per week for three years, though the frequency varied within and across years. Each histogram bin represents the number of observations that were made during a period of 14 days and the lines represent the earliest, the average and last recorded budburst observations. This demonstrates that across the different frequencies of observation, distances between early spring phenophases were similar across years}{figure.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces We show the potential allometry patterns across all years we had ring width for. For this, we randomly sampled 20 trees from our dataset and represent their ring width (mm) for each year.}}{61}{figure.caption.57}\protected@file@percent }
\newlabel{fig:allom}{{S3}{61}{We show the potential allometry patterns across all years we had ring width for. For this, we randomly sampled 20 trees from our dataset and represent their ring width (mm) for each year}{figure.caption.57}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Species level slope parameters which represent ring width change (log(mm)), per adjusted predictor (see `Data analyses' in Methods for more details). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different phenological predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season).}}{62}{table.caption.58}\protected@file@percent }
\newlabel{tab:wc_slope_table}{{S2}{62}{Species level slope parameters which represent ring width change (log(mm)), per adjusted predictor (see `Data analyses' in Methods for more details). We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different phenological predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season)}{table.caption.58}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces The effect of provenance on ring widths (log(mm)). We report these intercept estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season).}}{62}{table.caption.59}\protected@file@percent }
\newlabel{tab:wc_asite_table}{{S3}{62}{The effect of provenance on ring widths (log(mm)). We report these intercept estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season)}{table.caption.59}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Summary output of each parameter from our four predictors, using ring width (log(mm)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' in Methods section for more details.}}{63}{table.caption.60}\protected@file@percent }
\newlabel{tab:tab_all}{{S4}{63}{Summary output of each parameter from our four predictors, using ring width (log(mm)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See `Data analyses' in Methods section for more details}{table.caption.60}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Summary output of each parameter from our four predictors, using basal area increment (log($mm^2$)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See data analyses section for more details.}}{64}{table.caption.61}\protected@file@percent }
\newlabel{tab:BAItab}{{S5}{64}{Summary output of each parameter from our four predictors, using basal area increment (log($mm^2$)) as the response variable. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (GDD: growing degree days, GSL: growing season length, SOS: start of season and EOS: end of season). See data analyses section for more details}{table.caption.61}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Full vs most restricted datasets for the model with start of season (a-d) and end of season (d-h) as the predictor. Each panel represent the different parameters used to fit the models. $\sigma $ (a, e), $\alpha _{species}$ (c, g) and $\alpha _{year}$ (d,h) represent the ring width (log(mm)) for species and year, respectively. $\beta _{species}$ (b, f) represent the change in ring width (log(mm))/adjusted predictor, for each species (see 'Data analyses' section in Methods for more details).}}{65}{figure.caption.62}\protected@file@percent }
\newlabel{fig:wcSOSEOScomparison}{{S4}{65}{Full vs most restricted datasets for the model with start of season (a-d) and end of season (d-h) as the predictor. Each panel represent the different parameters used to fit the models. $\sigma $ (a, e), $\alpha _{species}$ (c, g) and $\alpha _{year}$ (d,h) represent the ring width (log(mm)) for species and year, respectively. $\beta _{species}$ (b, f) represent the change in ring width (log(mm))/adjusted predictor, for each species (see 'Data analyses' section in Methods for more details)}{figure.caption.62}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Ring width (log(mm)) trends in response to thermal season (growing degree days). The plots are the reconstructed species estimates posterior distribution with error. The lines represent the mean of the posterior distribution and the shaded area, the 50\% UI at each predictor value. The dots are the empirical data shaped by year.}}{66}{figure.caption.63}\protected@file@percent }
\newlabel{fig:wcxyGDD}{{S5}{66}{Ring width (log(mm)) trends in response to thermal season (growing degree days). The plots are the reconstructed species estimates posterior distribution with error. The lines represent the mean of the posterior distribution and the shaded area, the 50\% UI at each predictor value. The dots are the empirical data shaped by year}{figure.caption.63}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Ring width trends (log(mm)) in response to calendar season (growing season length). The plots are the reconstructed species estimates posterior distribution with error. The lines represent the mean of the posterior distribution and the shaded area, the 50\% UI at each predictor value. The dots are the empirical data shaped by year.}}{67}{figure.caption.64}\protected@file@percent }
\newlabel{fig:wcxyGSL}{{S6}{67}{Ring width trends (log(mm)) in response to calendar season (growing season length). The plots are the reconstructed species estimates posterior distribution with error. The lines represent the mean of the posterior distribution and the shaded area, the 50\% UI at each predictor value. The dots are the empirical data shaped by year}{figure.caption.64}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Ring width (log(mm)) deviations from the grand mean for grouping factor of the GDD model. The different tree id values represent the combined intercepts of tree id, provenance, species and averaged year intercepts. The larger dots and lines represent the species intercepts which are the species level estimates averaged across all of their tree ids. The dots are the mean of the posterior distribution and the thick and thin lines, the 50 and 90\% UI.}}{68}{figure.caption.65}\protected@file@percent }
\newlabel{fig:wcmuplotatreeid}{{S7}{68}{Ring width (log(mm)) deviations from the grand mean for grouping factor of the GDD model. The different tree id values represent the combined intercepts of tree id, provenance, species and averaged year intercepts. The larger dots and lines represent the species intercepts which are the species level estimates averaged across all of their tree ids. The dots are the mean of the posterior distribution and the thick and thin lines, the 50 and 90\% UI}{figure.caption.65}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces Boxplots representing the empirical data of our ring widths (mm) separated by species. The dots represent the raw data, the line is the mean and the box depicts the 50\% UI.}}{69}{figure.caption.66}\protected@file@percent }
\newlabel{fig:wcboxplotRW}{{S8}{69}{Boxplots representing the empirical data of our ring widths (mm) separated by species. The dots represent the raw data, the line is the mean and the box depicts the 50\% UI}{figure.caption.66}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces Boxplots representing the empirical data of all our predictors clustered by species, and for each year. The dots represent the raw data, the line is the mean and the box depicts the 50\% UI.}}{70}{figure.caption.67}\protected@file@percent }
\newlabel{fig:wcboxplotPred}{{S9}{70}{Boxplots representing the empirical data of all our predictors clustered by species, and for each year. The dots represent the raw data, the line is the mean and the box depicts the 50\% UI}{figure.caption.67}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces Effect size of each predictor across our four species. We depict ring width (log(mm)) change per adjusted predictor ($z$-scored; see data analyses section for more details) for each species. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (growing degree days, growing season length, start of season and end of season).}}{71}{figure.caption.68}\protected@file@percent }
\newlabel{fig:bsppZscored}{{S10}{71}{Effect size of each predictor across our four species. We depict ring width (log(mm)) change per adjusted predictor ($z$-scored; see data analyses section for more details) for each species. We report estimates as mean and 90\% uncertainty intervals (in square brackets) across our four different predictors (growing degree days, growing season length, start of season and end of season)}{figure.caption.68}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S11}{\ignorespaces Climate data overlap in 2020 for the two climate stations we used in our dataset (see data analyses section for more details). The lines represent the daily mean temperature of each climate station and the shaded area, the minimum and maximum daily temperature.}}{72}{figure.caption.69}\protected@file@percent }
\newlabel{fig:climOverlap}{{S11}{72}{Climate data overlap in 2020 for the two climate stations we used in our dataset (see data analyses section for more details). The lines represent the daily mean temperature of each climate station and the shaded area, the minimum and maximum daily temperature}{figure.caption.69}{}}
